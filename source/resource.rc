#include <winuser.h>
#include <winver.h>
#include "resource.h"
1 CREATEPROCESS_MANIFEST_RESOURCE_ID MOVEABLE PURE "app.manifest"
IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,6,1,0
 PRODUCTVERSION 3,6,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Better RGB Open Source Community\0"
            VALUE "FileDescription", "ITE8291 Chassis - Better RGB Adaptive\0"
            VALUE "FileVersion", "3.6.1\0"
            VALUE "InternalName", "BetterRGBAdaptive\0"
            VALUE "LegalCopyright", "MIT License; based on EpicYamo Better RGB\0"
            VALUE "OriginalFilename", "Better RGB Adaptive v2.exe\0"
            VALUE "ProductName", "BetterRGB ITE8291 Adaptive\0"
            VALUE "ProductVersion", "3.6.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
